{
  "manifest_version": 3,
  "name": "Canvas Speed Controller Plus",
  "version": "3.0",
  "description": "Controle a velocidade de animações em jogos HTML5 e conteúdo canvas - by markizin",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
